# StockSync Firebase/Firestore configuration
# Leave these blank to run in local-memory demo mode.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_FILE="./firebase-service-account.json"
FIREBASE_COLLECTION="inventory"
FIREBASE_DATABASE_ID="(default)"

# Optional server port
PORT=3000

# Optional: keep the existing Gemini key here if your app uses Gemini features.
GEMINI_API_KEY=""
